---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "themes/catppuccin-{{ flavor.identifier }}.css"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
/*!
 * Soothing pastel theme for Marp / Marpit.
 *
 * @theme catppuccin-{{ flavor.identifier }}
 * @author Catppuccin Org
 *
 * @auto-scaling true
 * @size 16:9 1280px 720px
 * @size 4:3 960px 720px
 */

@import "default";

/* Highlight.js */

pre :where(.hljs) {
  color: {{ text.hex }};
  background: {{ base.hex }};
}

pre :where(.hljs-keyword),
pre :where(.hljs-variable),
pre :where(.hljs-variable.language_),
pre :where(.hljs-name),
pre :where(.hljs-selector-attr) {
  color: {{ mauve.hex }};
}

pre :where(.hljs-built_in),
pre :where(.hljs-doctag) {
  color: {{ red.hex }};
}

pre :where(.hljs-type),
pre :where(.hljs-title.class_),
pre :where(.hljs-selector-tag) {
  color: {{ yellow.hex }};
}

pre :where(.hljs-literal),
pre :where(.hljs-number),
pre :where(.hljs-variable.constant_),
pre :where(.hljs-meta) {
  color: {{ peach.hex }};
}

pre :where(.hljs-operator) {
  color: {{ sky.hex }};
}

pre :where(.hljs-punctuation) {
  color: {{ subtext1.hex }};
}

pre :where(.hljs-property),
pre :where(.hljs-tag),
pre :where(.hljs-bullet),
pre :where(.hljs-formula),
pre :where(.hljs-selector-class),
pre :where(.hljs-selector-pseudo) {
  color: {{ teal.hex }};
}

pre :where(.hljs-regexp) {
  color: {{ pink.hex }};
}

pre :where(.hljs-string),
pre :where(.hljs-char.escape_),
pre :where(.hljs-attribute),
pre :where(.hljs-code) {
  color: {{ green.hex }};
}

pre :where(.hljs-subst) {
  color: {{ subtext0.hex }};
}

pre :where(.hljs-symbol),
pre :where(.hljs-template-tag),
pre :where(.hljs-template-variable) {
  color: {{ flamingo.hex }};
}

pre :where(.hljs-title),
pre :where(.hljs-title.function_),
pre :where(.hljs-section),
pre :where(.hljs-attr),
pre :where(.hljs-selector-id) {
  color: {{ blue.hex }};
}

pre :where(.hljs-params) {
  color: {{ text.hex }};
}

pre :where(.hljs-comment) {
  color: {{ overlay2.hex }};
}

pre :where(.hljs-emphasis) {
  color: {{ red.hex }};
  font-style: italic;
}

pre :where(.hljs-strong) {
  color: {{ red.hex }};
  font-weight: bold;
}

pre :where(.hljs-link) {
  color: {{ sapphire.hex }};
  font-style: italic;
}

pre :where(.hljs-quote) {
  color: {{ green.hex }};
  font-style: italic;
}

pre :where(.hljs-addition) {
  color: {{ green.hex }};
  background: {{ green | mod(opacity=0.15) | css_rgba }};
}

pre :where(.hljs-deletion) {
  color: {{ red.hex }};
  background: {{ red | mod(opacity=0.15) | css_rgba }};
}

:root {
  /* Color palette CSS variables */
  {%- for key, color in flavor.colors %}
  --{{key}}: {{color.hex}};
  {%- for opacity in [10,20,30,40,50,60,70,80,90] %}
  --{{key}}-{{opacity}}: {{ color | mod(opacity=opacity / 100.0) | css_rgba }};
  {%- endfor %}
  {%- endfor %}

  /* github-markdown-css variables */
  --bgColor-attention-muted: {{ peach | mod(opacity=0.15) | css_rgba }};
  --bgColor-default: var(--{{ base.identifier }});
  --bgColor-muted: var(--{{ surface0.identifier }});
  --bgColor-neutral-muted: var(--{{ overlay0.identifier }});
  --borderColor-accent-emphasis: var(--{{ red.identifier }});
  --borderColor-attention-emphasis: var(--{{ peach.identifier }});
  --borderColor-danger-emphasis: var(--{{ red.identifier }});
  --borderColor-default: var(--{{ surface0.identifier }});
  --borderColor-done-emphasis: var(--{{ mauve.identifier }});
  --borderColor-muted: var(--{{ surface0.identifier }});
  --borderColor-success-emphasis: var(--{{ green.identifier }});
  --fgColor-accent: var(--{{ red.identifier }});
  --fgColor-attention: var(--{{ yellow.identifier }});
  --fgColor-danger: var(--{{ red.identifier }});
  --fgColor-default: var(--{{ text.identifier }});
  --fgColor-done: var(--{{ mauve.identifier }});
  --fgColor-muted: var(--{{ subtext1.identifier }});
  --fgColor-success: var(--{{ green.identifier }});

  /* Marp default theme variables */
  --h1-color: var(--{{ red.identifier }});
  --header-footer-color: var(--{{ surface1.identifier }});
  --heading-strong-color: var(--{{ red.identifier }});
  --paginate-color: var(--{{ overlay0.identifier }});
}

section h1 {
  color: var(--{{ red.identifier }});
}

section h2 {
  color: var(--{{ peach.identifier }});
}

section h3 {
  color: var(--{{ yellow.identifier }});
}

section h4 {
  color: var(--{{ green.identifier }});
}

section h5 {
  color: var(--{{ sapphire.identifier }});
}

section h6 {
  color: var(--{{ lavender.identifier }});
}

section a {
  color: var(--{{ blue.identifier }});
}

section table thead th {
  background: var(--bgColor-muted);
  color: var(--fgColor-muted);
}

section table tbody > tr:nth-child(2n) td,
section table tbody > tr:nth-child(2n) th {
  background: var(--bgColor-default);
  color: var(--fgColor-default);
}

section .markdown-alert.markdown-alert-note {
  border-left-color: var(--{{ blue.identifier }});
}

section .markdown-alert.markdown-alert-note .markdown-alert-title {
  color: var(--{{ blue.identifier }});
}

/* Lead class taken from Marp builtin Gaia theme */
section:where(.lead) {
  place-content: safe center center;
  /* Definitions for classic behavior: Users can adopt flex centering by tweaking style `section.lead { display: flex }` */
  flex-flow: column nowrap;
  align-items: stretch;
}

section:where(.lead) h1,
section:where(.lead) h2,
section:where(.lead) h3,
section:where(.lead) h4,
section:where(.lead) h5,
section:where(.lead) h6 {
  text-align: center;
}

section:where(.lead) p {
  text-align: center;
}

section:where(.lead) blockquote > h1,
section:where(.lead) blockquote > h2,
section:where(.lead) blockquote > h3,
section:where(.lead) blockquote > h4,
section:where(.lead) blockquote > h5,
section:where(.lead) blockquote > h6,
section:where(.lead) blockquote > p {
  text-align: left;
}

section:where(.lead) ul > li > p,
section:where(.lead) ol > li > p {
  text-align: left;
}

section:where(.lead) table {
  margin-left: auto;
  margin-right: auto;
}
